# ── Supabase — ACELAȘI proiect ca aplicația principală ────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── URL-ul public al directorului (domeniul dedicat, fără trailing slash) ─
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# ── Brandul directorului (până se alege numele/domeniul final) ────────────
NEXT_PUBLIC_DIRECTOR_NAME=Descoperă Local

# ── Stripe — planul „Promovat” (opțional până activezi plățile) ───────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_FEATURED=price_...

# ── Asistentul AI de recomandări (opțional — fără cheie folosește un
#    parser local mai simplu). Cheie de pe https://platform.claude.com ─────
ANTHROPIC_API_KEY=
# Modelul folosit (implicit claude-opus-4-8):
ANTHROPIC_MODEL=claude-opus-4-8
