# ── Supabase (obligatoriu) ────────────────────────────────────────────────
# Creează un proiect gratuit pe https://supabase.com, apoi copiază din
# Project Settings → API:
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Service role key — folosit DOAR server-side (webhooks, joburi):
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── URL public al aplicației (fără trailing slash) ────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── fal.ai — generare video AI (Faza 2, opțional până activezi feature-ul) ─
# Cheie de pe https://fal.ai/dashboard/keys
FAL_KEY=
# Modelul image-to-video folosit (cost ~$0.07/secundă):
FAL_VIDEO_MODEL=fal-ai/kling-video/v2.5-turbo/pro/image-to-video

# ── Google PageSpeed Insights (Faza 3, opțional — merge și fără cheie,
#    dar cu limite mici de rată) ──────────────────────────────────────────
PAGESPEED_API_KEY=

# ── Stripe (Faza 4, opțional până activezi plățile) ───────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Price ID-uri create în dashboard-ul Stripe:
STRIPE_PRICE_START=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_SETUP=price_...

# ── Notificări email (opțional, prin https://resend.com) ──────────────────
RESEND_API_KEY=
# Adresa care primește lead-urile de servicii SEO:
ADMIN_EMAIL=pavel.gabriell@gmail.com
